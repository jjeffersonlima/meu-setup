#!/usr/bin/env bash
# ==============================================================================
# meu-setup: novo-projeto
# Utilitário para inicializar rapidamente projetos de automações, sites e apps.
# Suporta execução interativa e argumentos de linha de comando.
# ==============================================================================

set -e

# Cores para o terminal
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m' # No Color

mostrar_banner() {
    if [ -t 1 ]; then
        echo -e "${CYAN}"
        echo "  ╔══════════════════════════════════════════════════╗"
        echo "  ║            🚀 Gerador de Novos Projetos          ║"
        echo "  ║                   meu-setup                      ║"
        echo "  ╚══════════════════════════════════════════════════╝"
        echo -e "${NC}"
    fi
}

mostrar_ajuda() {
    echo "Uso: novo-projeto [TIPO] [NOME]"
    echo "  ou: novo-projeto --type [TIPO] --name [NOME]"
    echo ""
    echo "Tipos disponíveis:"
    echo "  astro     Site moderno com Astro"
    echo "  python    Projeto de automação ou script Python com uv"
    echo "  node      Projeto Node.js com TypeScript e tsx"
    echo "  docker    Ambiente Docker Compose (PostgreSQL + Redis)"
    echo ""
    echo "Exemplos:"
    echo "  novo-projeto python meu-bot"
    echo "  novo-projeto astro meu-blog"
    echo "  novo-projeto node api-vendas"
    echo "  novo-projeto docker infra-banco"
}

criar_projeto_astro() {
    local nome="$1"
    echo -e "\n${BLUE}▶ Criando site com Astro: ${YELLOW}$nome${NC}"
    
    if command -v pnpm >/dev/null 2>&1; then
        pnpm create astro@latest "$nome"
    elif command -v npm >/dev/null 2>&1; then
        npm create astro@latest "$nome"
    else
        echo -e "${RED}Erro: pnpm ou npm não foram encontrados! Execute o install.sh primeiro.${NC}"
        exit 1
    fi

    echo -e "\n${GREEN}✔ Projeto Astro '$nome' criado com sucesso!${NC}"
    echo -e "${YELLOW}Para começar:${NC}"
    echo -e "  cd $nome"
    echo -e "  pnpm dev (ou npm run dev)\n"
}

criar_projeto_python() {
    local nome="$1"
    echo -e "\n${BLUE}▶ Criando projeto de automação/app Python: ${YELLOW}$nome${NC}"
    mkdir -p "$nome"
    cd "$nome"

    if command -v uv >/dev/null 2>&1; then
        uv init --app
        echo -e "${GREEN}✔ Projeto inicializado com uv (super rápido).${NC}"
    else
        python3 -m venv .venv
        echo "print('Olá do seu novo projeto de automação!')" > main.py
        echo "# $nome" > README.md
        echo -e "${GREEN}✔ Projeto inicializado com python3-venv.${NC}"
    fi

    if [ ! -f .gitignore ]; then
        cat << 'EOF' > .gitignore
.venv/
__pycache__/
*.pyc
.env
EOF
    fi

    # Cria arquivo .env de exemplo
    cat << 'EOF' > .env.example
# Variáveis de ambiente do projeto
AMBIENTE=desenvolvimento
API_KEY=sua_chave_aqui
EOF

    if command -v git >/dev/null 2>&1 && [ ! -d .git ]; then
        git init -b main >/dev/null 2>&1 || git init >/dev/null 2>&1
    fi

    echo -e "\n${GREEN}✔ Projeto Python '$nome' pronto!${NC}"
    echo -e "${YELLOW}Para começar:${NC}"
    echo -e "  cd $nome"
    if command -v uv >/dev/null 2>&1; then
        echo -e "  uv run hello.py (ou main.py)"
        echo -e "  uv add requests (para adicionar pacotes como o requests)"
    else
        echo -e "  source .venv/bin/activate"
        echo -e "  python3 main.py"
    fi
    echo ""
}

criar_projeto_docker() {
    local nome="$1"
    echo -e "\n${BLUE}▶ Criando projeto com Docker Compose: ${YELLOW}$nome${NC}"
    mkdir -p "$nome"
    cd "$nome"

    cat << 'EOF' > docker-compose.yml
services:
  # Exemplo de banco de dados PostgreSQL pronto para uso
  postgres:
    image: postgres:16-alpine
    container_name: app_postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: usuario
      POSTGRES_PASSWORD: senha_segura
      POSTGRES_DB: meu_banco
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data

  # Exemplo de cache Redis
  redis:
    image: redis:alpine
    container_name: app_redis
    ports:
      - "6379:6379"

volumes:
  pgdata:
EOF

    cat << 'EOF' > README.md
# Ambiente Dockerizado

Este diretório contém uma estrutura com PostgreSQL e Redis prontos para conectar em seus sites ou automações.

## Comandos rápidos:
- Subir os containers: \`docker compose up -d\`
- Ver logs: \`docker compose logs -f\`
- Parar containers: \`docker compose down\`
EOF

    if command -v git >/dev/null 2>&1 && [ ! -d .git ]; then
        git init -b main >/dev/null 2>&1 || git init >/dev/null 2>&1
    fi

    echo -e "\n${GREEN}✔ Projeto Docker Compose '$nome' pronto!${NC}"
    echo -e "${YELLOW}Para rodar os serviços:${NC}"
    echo -e "  cd $nome"
    echo -e "  docker compose up -d\n"
}

criar_projeto_node() {
    local nome="$1"
    echo -e "\n${BLUE}▶ Criando projeto Node.js / TypeScript: ${YELLOW}$nome${NC}"
    mkdir -p "$nome"
    cd "$nome"

    if command -v pnpm >/dev/null 2>&1; then
        pnpm init
        pnpm add -D typescript @types/node tsx 2>/dev/null || true
    else
        npm init -y
        npm install --save-dev typescript @types/node tsx 2>/dev/null || true
    fi

    mkdir -p src
    cat << 'EOF' > src/index.ts
console.log("🚀 Olá mundo do Node.js + TypeScript!");
EOF

    cat << 'EOF' > .gitignore
node_modules/
dist/
.env
EOF

    if command -v git >/dev/null 2>&1 && [ ! -d .git ]; then
        git init -b main >/dev/null 2>&1 || git init >/dev/null 2>&1
    fi

    echo -e "\n${GREEN}✔ Projeto Node.js '$nome' pronto!${NC}"
    echo -e "${YELLOW}Para rodar:${NC}"
    echo -e "  cd $nome"
    echo -e "  npx tsx src/index.ts\n"
}

# --- Processamento de Argumentos CLI ---
tipo=""
nome=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            mostrar_ajuda
            exit 0
            ;;
        --type)
            tipo="$2"
            shift 2
            ;;
        --name)
            nome="$2"
            shift 2
            ;;
        astro|python|node|docker)
            tipo="$1"
            if [ -n "${2:-}" ] && [[ "$2" != -* ]]; then
                nome="$2"
                shift 2
            else
                shift 1
            fi
            ;;
        *)
            if [ -z "$tipo" ]; then
                tipo="$1"
            elif [ -z "$nome" ]; then
                nome="$1"
            fi
            shift
            ;;
    esac
done

if [ -n "$tipo" ]; then
    case "$tipo" in
        astro)
            nome=${nome:-meu-site}
            criar_projeto_astro "$nome"
            exit 0
            ;;
        python)
            nome=${nome:-automacao-python}
            criar_projeto_python "$nome"
            exit 0
            ;;
        node)
            nome=${nome:-app-node}
            criar_projeto_node "$nome"
            exit 0
            ;;
        docker)
            nome=${nome:-stack-docker}
            criar_projeto_docker "$nome"
            exit 0
            ;;
        *)
            echo -e "${RED}Tipo desconhecido: '$tipo'.${NC}"
            mostrar_ajuda
            exit 1
            ;;
    esac
fi

# Se não foram passados argumentos via CLI, abre o menu interativo
mostrar_banner

echo -e "Escolha o tipo de projeto que deseja criar:\n"
echo -e "  ${YELLOW}1)${NC} 🌐 Site moderno com ${GREEN}Astro${NC} (Recomendado para sites rápidos)"
echo -e "  ${YELLOW}2)${NC} 🐍 Automação ou App em ${GREEN}Python${NC} (com uv, virtualenv e .env)"
echo -e "  ${YELLOW}3)${NC} ⬢ Projeto ${GREEN}Node.js + TypeScript${NC} (APIs e sistemas)"
echo -e "  ${YELLOW}4)${NC} 🐳 Ambiente ${GREEN}Docker Compose${NC} (Banco PostgreSQL + Redis)"
echo -e "  ${YELLOW}5)${NC} ❌ Sair\n"

read -rp "Opção [1-5]: " opcao

case "$opcao" in
    1)
        read -rp "Nome do novo site Astro (ex: meu-site): " nome_proj
        nome_proj=${nome_proj:-meu-site}
        criar_projeto_astro "$nome_proj"
        ;;
    2)
        read -rp "Nome do projeto Python (ex: automacao-dados): " nome_proj
        nome_proj=${nome_proj:-automacao-python}
        criar_projeto_python "$nome_proj"
        ;;
    3)
        read -rp "Nome do projeto Node (ex: minha-api): " nome_proj
        nome_proj=${nome_proj:-app-node}
        criar_projeto_node "$nome_proj"
        ;;
    4)
        read -rp "Nome da pasta do ambiente Docker (ex: stack-banco): " nome_proj
        nome_proj=${nome_proj:-stack-docker}
        criar_projeto_docker "$nome_proj"
        ;;
    5)
        echo -e "${YELLOW}Operação cancelada.${NC}"
        exit 0
        ;;
    *)
        echo -e "${RED}Opção inválida.${NC}"
        exit 1
        ;;
esac
