#!/usr/bin/env bash
# meu-setup: gerador de projetos para estudo. Nunca sobrescreve um destino existente.
set -Eeuo pipefail
DIR_SETUP="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
# shellcheck source=lib/common.sh
source "$DIR_SETUP/lib/common.sh"
# shellcheck source=configs/versions.env
source "$DIR_SETUP/configs/versions.env"
help() {
    cat <<'HELP'
Uso: novo-projeto [astro|python|node|docker] [nome]
  ou novo-projeto --type TIPO --name NOME
Sem argumentos, abre o menu. Use letras minúsculas, números, - e _ no nome.
HELP
}
tipo="" nome=""
while (($#)); do
    case "$1" in
        -h|--help) help; exit 0 ;;
        --type|--name)
            if [ "$#" -lt 2 ] || [[ "$2" == -* ]]; then echo "Informe o valor após $1." >&2; exit 2; fi
            if [ "$1" = --type ]; then tipo="$2"; else nome="$2"; fi
            shift 2 ;;
        -*) echo "Opção desconhecida: $1" >&2; exit 2 ;;
        *) if [ -z "$tipo" ]; then tipo="$1"; elif [ -z "$nome" ]; then nome="$1"; else echo 'Argumentos em excesso.' >&2; exit 2; fi; shift ;;
    esac
done
if [ -z "$tipo" ]; then
    [ -t 0 ] || { help >&2; exit 2; }
    echo '1) Site Astro  2) Automação Python  3) Node/TypeScript  4) Banco Docker  5) Sair'
    read -rp 'Escolha [1-5]: ' choice
    case "$choice" in 1) tipo=astro ;; 2) tipo=python ;; 3) tipo=node ;; 4) tipo=docker ;; 5) exit 0 ;; *) echo 'Escolha inválida.' >&2; exit 2 ;; esac
    read -rp 'Nome do projeto: ' nome
fi
case "$tipo" in astro|python|node|docker) ;; *) echo "Tipo desconhecido: $tipo" >&2; exit 2 ;; esac
nome="${nome:-meu-$tipo}"
[[ "$nome" =~ ^[a-z][a-z0-9_-]*$ ]] || { echo 'Nome inválido: use letras minúsculas, números, - e _, começando com letra.' >&2; exit 2; }
if [ -e "$nome" ] || [ -L "$nome" ]; then echo "O destino '$nome' já existe. Escolha outro nome; seus arquivos foram preservados." >&2; exit 1; fi
setup_environment
# Verifica pré-requisitos antes de criar qualquer arquivo.
case "$tipo" in
    python) setup_native uv || { echo 'uv não encontrado. Execute o instalador e selecione Python.' >&2; exit 1; } ;;
    node|astro) if ! setup_native node || ! setup_node_compatible || ! setup_native pnpm; then echo 'Node/pnpm Linux ausentes. Execute o instalador e selecione Node.' >&2; exit 1; fi ;;
esac
mkdir -- "$nome"
project_dir="$(pwd)/$nome"
status=0
trap 'status=$?; echo "Criação interrompida. A pasta $project_dir foi preservada para inspeção; não está pronta. Código: $status." >&2; exit "$status"' ERR
cd -- "$nome"
case "$tipo" in
    python)
        timeout 60 uv init --app --no-package --vcs none
        cp "$DIR_SETUP/templates/python-automacao/main.py" main.py
        printf 'AMBIENTE=desenvolvimento\nAPI_KEY=sua_chave_aqui\n' > .env.example
        run='uv run main.py'
        ;;
    node)
        python3 - "$nome" "$TYPESCRIPT_VERSION" "$TSX_VERSION" "$NODE_TYPES_VERSION" <<'PY'
import json, pathlib, sys
name, typescript, tsx, node_types = sys.argv[1:]
config = {'name': name.replace('_', '-'), 'version': '0.1.0', 'private': True, 'type': 'module',
          'scripts': {'dev': 'tsx src/index.ts', 'start': 'tsx src/index.ts', 'check': 'tsc --noEmit'},
          'devDependencies': {'typescript': typescript, 'tsx': tsx, '@types/node': node_types}}
pathlib.Path('package.json').write_text(json.dumps(config, indent=2) + '\n')
pathlib.Path('tsconfig.json').write_text(json.dumps({'compilerOptions': {'target': 'ES2022', 'module': 'NodeNext', 'moduleResolution': 'NodeNext', 'strict': True, 'skipLibCheck': True}, 'include': ['src']}, indent=2) + '\n')
PY
        mkdir src
        echo 'console.log("Olá! Seu projeto Node.js + TypeScript está funcionando.");' > src/index.ts
        printf 'allowBuilds:\n  esbuild: true\n' > pnpm-workspace.yaml
        timeout 240 pnpm install --config.fetchRetries=2 --config.fetchTimeout=30000
        timeout 30 pnpm check
        run='pnpm dev'
        ;;
    astro)
        cp -R "$DIR_SETUP/templates/astro/." .
        python3 - "$nome" "$ASTRO_VERSION" <<'PYASTRO'
import json, pathlib, sys
name, version = sys.argv[1:]
pathlib.Path('package.json').write_text(json.dumps({'name': name.replace('_', '-'), 'version': '0.1.0',
    'private': True, 'type': 'module', 'scripts': {'dev': 'astro dev', 'build': 'astro build', 'preview': 'astro preview'},
    'dependencies': {'astro': version}}, indent=2) + '\n')
pathlib.Path('tsconfig.json').write_text('{"extends":"astro/tsconfigs/strict"}\n')
PYASTRO
        printf 'allowBuilds:\n  esbuild: true\n  sharp: true\n' > pnpm-workspace.yaml
        timeout 240 pnpm install --config.fetchRetries=2 --config.fetchTimeout=30000
        timeout 120 pnpm build
        run='pnpm dev'
        ;;
    docker)
        cat > docker-compose.yml <<'COMPOSE'
services:
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: estudante
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?Defina POSTGRES_PASSWORD no arquivo .env}
      POSTGRES_DB: estudos
    ports:
      - "127.0.0.1:${POSTGRES_PORT:-5432}:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
  redis:
    image: redis:7-alpine
    ports:
      - "127.0.0.1:${REDIS_PORT:-6379}:6379"
volumes:
  pgdata:
COMPOSE
        # Credencial local própria de cada projeto, sem sobrescrever arquivos existentes.
        python3 - <<'PY'
import pathlib, secrets
pathlib.Path('.env').write_text('POSTGRES_PASSWORD=' + secrets.token_urlsafe(24) + '\nPOSTGRES_PORT=5432\nREDIS_PORT=6379\n')
pathlib.Path('.env').chmod(0o600)
pathlib.Path('.env.example').write_text('POSTGRES_PASSWORD=escolha_uma_senha\nPOSTGRES_PORT=5432\nREDIS_PORT=6379\n')
PY
        run='docker compose up -d'
        ;;
esac
# Acrescenta somente padrões ausentes no projeto que acabou de ser criado.
for pattern in .env .venv/ __pycache__/ node_modules/ dist/; do
    if ! grep -qxF "$pattern" .gitignore 2>/dev/null; then printf '%s\n' "$pattern" >> .gitignore; fi
done
# Cercas Markdown literais.
# shellcheck disable=SC2016
printf '# %s\n\nPara começar:\n\n```bash\n%s\n```\n' "$nome" "$run" >> README.md
if [ "$tipo" = docker ]; then
    cat >> README.md <<'DOCKER_DOC'

Se uma porta estiver ocupada, altere POSTGRES_PORT ou REDIS_PORT no arquivo .env.
Pare os serviços com `docker compose down`. Os dados PostgreSQL ficam no volume do projeto.
DOCKER_DOC
fi
if setup_native git && [ ! -e .git ]; then git init -q -b main; fi
trap - ERR
printf '\nProjeto %s pronto.\n  cd %s\n  %s\n' "$nome" "$nome" "$run"
