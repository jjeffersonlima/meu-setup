#!/usr/bin/env bash
# ==============================================================================
# meu-setup: diagnostico (doctor)
# Script de verificação de integridade e auditoria de saúde do ambiente WSL.
# ==============================================================================

set -u

# Paleta de cores para o terminal
BOLD='\033[1m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
RED='\033[0;31m'
NC='\033[0m' # No Color

mostrar_banner() {
    echo -e "${CYAN}"
    echo "  ╔════════════════════════════════════════════════════════════════╗"
    echo "  ║           🩺  meu-setup: Diagnóstico de Integridade           ║"
    echo "  ║             Auditoria de Saúde das Ferramentas no WSL          ║"
    echo "  ╚════════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

TOTAL_VERIFICACOES=0
TOTAL_SUCESSOS=0
TOTAL_AVISOS=0
TOTAL_FALHAS=0

# Formata linha da tabela com alinhamento
imprimir_linha_tabela() {
    local componente="$1"
    local status="$2"
    local detalhes="$3"
    printf "  %-28s %-28b %s\n" "$componente" "$status" "$detalhes"
}

mostrar_banner

echo -e "${BOLD}Iniciando varredura dos componentes do sistema...${NC}\n"
printf "  ${BOLD}%-30s %-20s %-35s${NC}\n" "COMPONENTE" "STATUS" "DETALHES"
echo "  ---------------------------------------------------------------------------------------"

# 1. WSL & Systemd
((TOTAL_VERIFICACOES++))
if [ -f "/etc/wsl.conf" ] && grep -q "systemd=true" "/etc/wsl.conf" 2>/dev/null; then
    if command -v systemctl >/dev/null 2>&1 && systemctl is-system-running >/dev/null 2>&1; then
        ((TOTAL_SUCESSOS++))
        imprimir_linha_tabela "WSL Systemd" "${GREEN}✔ ATIVO${NC}" "systemd em execução"
    else
        ((TOTAL_AVISOS++))
        imprimir_linha_tabela "WSL Systemd" "${YELLOW}⚠ CONFIGURADO${NC}" "requer 'wsl --shutdown' no Windows"
    fi
else
    ((TOTAL_FALHAS++))
    imprimir_linha_tabela "WSL Systemd" "${RED}✖ AUSENTE${NC}" "systemd=true não encontrado em /etc/wsl.conf"
fi

# 2. CLI Essentials (curl, git, jq, fzf, ripgrep, build-essential)
((TOTAL_VERIFICACOES++))
ESSENCIAIS_FALTANDO=()
for cmd in curl git jq fzf rg make gcc; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        ESSENCIAIS_FALTANDO+=("$cmd")
    fi
done

if [ ${#ESSENCIAIS_FALTANDO[@]} -eq 0 ]; then
    ((TOTAL_SUCESSOS++))
    imprimir_linha_tabela "CLI Essentials" "${GREEN}✔ SUCESSO${NC}" "curl, git, jq, fzf, rg, gcc ok"
else
    ((TOTAL_FALHAS++))
    imprimir_linha_tabela "CLI Essentials" "${RED}✖ INCOMPLETO${NC}" "faltam: ${ESSENCIAIS_FALTANDO[*]}"
fi

# 3. Starship Prompt
((TOTAL_VERIFICACOES++))
if command -v starship >/dev/null 2>&1; then
    STARSHIP_VER=$(starship --version 2>/dev/null | head -n 1 | awk '{print $2}')
    ((TOTAL_SUCESSOS++))
    imprimir_linha_tabela "Starship Prompt" "${GREEN}✔ SUCESSO${NC}" "v${STARSHIP_VER}"
else
    ((TOTAL_FALHAS++))
    imprimir_linha_tabela "Starship Prompt" "${RED}✖ NÃO INSTALADO${NC}" "starship não encontrado no PATH"
fi

# 4. Node.js & pnpm & fnm
((TOTAL_VERIFICACOES++))
NODE_STATUS=""
if command -v fnm >/dev/null 2>&1 && command -v node >/dev/null 2>&1 && command -v pnpm >/dev/null 2>&1; then
    NODE_VER=$(node -v 2>/dev/null)
    PNPM_VER=$(pnpm -v 2>/dev/null)
    ((TOTAL_SUCESSOS++))
    imprimir_linha_tabela "Node.js & pnpm (fnm)" "${GREEN}✔ SUCESSO${NC}" "Node ${NODE_VER} | pnpm v${PNPM_VER}"
elif command -v node >/dev/null 2>&1; then
    ((TOTAL_AVISOS++))
    imprimir_linha_tabela "Node.js & pnpm (fnm)" "${YELLOW}⚠ PARCIAL${NC}" "Node $(node -v) sem pnpm/fnm"
else
    ((TOTAL_FALHAS++))
    imprimir_linha_tabela "Node.js & pnpm (fnm)" "${RED}✖ NÃO INSTALADO${NC}" "fnm/node não encontrados"
fi

# 5. Python & uv
((TOTAL_VERIFICACOES++))
if command -v uv >/dev/null 2>&1; then
    UV_VER=$(uv --version 2>/dev/null | awk '{print $2}')
    ((TOTAL_SUCESSOS++))
    imprimir_linha_tabela "Python (uv)" "${GREEN}✔ SUCESSO${NC}" "uv v${UV_VER} (Astral)"
else
    ((TOTAL_FALHAS++))
    imprimir_linha_tabela "Python (uv)" "${RED}✖ NÃO INSTALADO${NC}" "uv não encontrado no PATH"
fi

# 6. Docker Engine & Docker Compose
((TOTAL_VERIFICACOES++))
if command -v docker >/dev/null 2>&1; then
    DOCKER_VER=$(docker --version 2>/dev/null | awk '{print $3}' | tr -d ',')
    COMPOSE_STATUS=""
    if docker compose version >/dev/null 2>&1; then
        COMPOSE_STATUS="Compose v2 ok"
    else
        COMPOSE_STATUS="Compose ausente"
    fi

    if docker info >/dev/null 2>&1; then
        ((TOTAL_SUCESSOS++))
        imprimir_linha_tabela "Docker Engine" "${GREEN}✔ ATIVO${NC}" "v${DOCKER_VER} (${COMPOSE_STATUS})"
    elif sudo docker info >/dev/null 2>&1 || (command -v systemctl >/dev/null 2>&1 && sudo systemctl is-active --quiet docker); then
        ((TOTAL_AVISOS++))
        imprimir_linha_tabela "Docker Engine" "${YELLOW}⚠ ATIVO (RELOG REQUERIDO)${NC}" "Ativo no systemd (reinicie terminal p/ usar sem sudo)"
    else
        ((TOTAL_AVISOS++))
        imprimir_linha_tabela "Docker Engine" "${YELLOW}⚠ INATIVO${NC}" "Daemon parado (sudo systemctl start docker)"
    fi
else
    ((TOTAL_FALHAS++))
    imprimir_linha_tabela "Docker Engine" "${RED}✖ NÃO INSTALADO${NC}" "docker.io não instalado"
fi

# 7. Permissão de Grupo Docker
((TOTAL_VERIFICACOES++))
if id -nG 2>/dev/null | grep -qw "docker"; then
    ((TOTAL_SUCESSOS++))
    imprimir_linha_tabela "Grupo Docker ($USER)" "${GREEN}✔ ATIVO NA SESSÃO${NC}" "Permissão para rodar sem sudo pronta"
elif groups "$USER" 2>/dev/null | grep -qw "docker"; then
    ((TOTAL_AVISOS++))
    imprimir_linha_tabela "Grupo Docker ($USER)" "${YELLOW}⚠ PENDENTE NA SESSÃO${NC}" "Cadastrado no grupo; feche e reabra o terminal"
else
    ((TOTAL_AVISOS++))
    imprimir_linha_tabela "Grupo Docker ($USER)" "${YELLOW}⚠ NÃO CONFIGURADO${NC}" "Requer: sudo usermod -aG docker $USER"
fi

# 8. Lazydocker (Docker Visual)
((TOTAL_VERIFICACOES++))
if command -v lazydocker >/dev/null 2>&1 || [ -f "$HOME/.local/bin/lazydocker" ]; then
    LAZY_VER=$("$HOME/.local/bin/lazydocker" --version 2>/dev/null | grep "Version:" | awk '{print $2}')
    ((TOTAL_SUCESSOS++))
    imprimir_linha_tabela "Lazydocker (ld)" "${GREEN}✔ SUCESSO${NC}" "v${LAZY_VER:-0.25.2} (TUI ativo)"
else
    ((TOTAL_FALHAS++))
    imprimir_linha_tabela "Lazydocker (ld)" "${RED}✖ NÃO INSTALADO${NC}" "lazydocker ausente em ~/.local/bin"
fi

# 9. Git & Identidade & Chave SSH
((TOTAL_VERIFICACOES++))
GIT_NAME=$(git config --global user.name || true)
GIT_EMAIL=$(git config --global user.email || true)
SSH_EXISTS=$([ -f "$HOME/.ssh/id_ed25519" ] && echo "SSH Ed25519 ativa" || echo "Sem chave SSH local")

if [ -n "$GIT_NAME" ] && [ -n "$GIT_EMAIL" ]; then
    ((TOTAL_SUCESSOS++))
    imprimir_linha_tabela "Git & Identidade" "${GREEN}✔ SUCESSO${NC}" "$GIT_NAME ($SSH_EXISTS)"
else
    ((TOTAL_AVISOS++))
    imprimir_linha_tabela "Git & Identidade" "${YELLOW}⚠ PARCIAL${NC}" "Nome ou e-mail git não configurados"
fi

# 10. Utilitários locais e Aliases (~/.bashrc)
((TOTAL_VERIFICACOES++))
if [ -L "$HOME/.local/bin/novo-projeto" ] && [ -L "$HOME/.local/bin/atualizar" ]; then
    ((TOTAL_SUCESSOS++))
    imprimir_linha_tabela "Utilitários meu-setup" "${GREEN}✔ SUCESSO${NC}" "Symlinks ativos (novo, atualizar)"
elif [ -f "$HOME/.local/bin/novo-projeto" ]; then
    ((TOTAL_AVISOS++))
    imprimir_linha_tabela "Utilitários meu-setup" "${YELLOW}⚠ CÓPIA DIRETA${NC}" "Scripts presentes sem symlinks"
else
    ((TOTAL_FALHAS++))
    imprimir_linha_tabela "Utilitários meu-setup" "${RED}✖ AUSENTE${NC}" "Atalhos ausentes em ~/.local/bin"
fi

echo "  ---------------------------------------------------------------------------------------"

# Resumo Final e Saúde do Sistema
echo ""
ESPACO_DISCO=$(df -h / | awk 'NR==2 {print $4 " livres de " $2 " (usado: " $5 ")"}')
echo -e "  💾 ${BOLD}Espaço em Disco WSL:${NC} $ESPACO_DISCO"

PORTAS_ATIVAS=$(ss -tulan 2>/dev/null | grep LISTEN | wc -l || echo "0")
echo -e "  🔌 ${BOLD}Portas em Escuta:${NC}    $PORTAS_ATIVAS serviços locais ativos"

# Log mais recente disponível
LOG_LATEST="$HOME/.local/state/meu-setup/logs/install_latest.log"
if [ -f "$LOG_LATEST" ]; then
    echo -e "  📄 ${BOLD}Último Log de Instalação:${NC} $LOG_LATEST"
fi

echo ""
if [ "$TOTAL_FALHAS" -eq 0 ] && [ "$TOTAL_AVISOS" -eq 0 ]; then
    echo -e "  ${GREEN}${BOLD}🎉 Diagnóstico Perfeito: Todos os $TOTAL_SUCESSOS componentes estão 100% íntegros!${NC}\n"
    exit 0
elif [ "$TOTAL_FALHAS" -eq 0 ]; then
    echo -e "  ${YELLOW}${BOLD}✔ Ambiente Funcional: $TOTAL_SUCESSOS aprovados, $TOTAL_AVISOS aviso(s) leve(s).${NC}\n"
    exit 0
else
    echo -e "  ${RED}${BOLD}✖ Atenção: $TOTAL_FALHAS componente(s) falharam e precisam de correção.${NC}\n"
    exit 1
fi
