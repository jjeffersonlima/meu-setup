#!/usr/bin/env bash
# meu-setup: diagnóstico de leitura, sem sudo e sem efeitos na inicialização.
set -euo pipefail
DIR_SETUP="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
# shellcheck source=lib/common.sh
source "$DIR_SETUP/lib/common.sh"
setup_environment
export npm_config_offline=true COREPACK_ENABLE_NETWORK=0
exec python3 -B "$DIR_SETUP/lib/doctor.py" "$@"
