#!/usr/bin/env bash
# meu-setup: Portainer sob demanda, com preservação do volume persistente.
set -Eeuo pipefail
DIR_SETUP="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
# shellcheck source=lib/common.sh
source "$DIR_SETUP/lib/common.sh"
# shellcheck source=configs/versions.env
source "$DIR_SETUP/configs/versions.env"
umask 077
container="${SETUP_PORTAINER_NAME:-portainer}"
volume="${SETUP_PORTAINER_VOLUME:-portainer_data}"
http_port="${SETUP_PORTAINER_HTTP_PORT:-9000}"
https_port="${SETUP_PORTAINER_HTTPS_PORT:-9443}"
help() {
    cat <<'HELP'
Uso: portainer [comando] [--lan]
  start       Inicia o painel (padrão: http://localhost:9000)
  repair      Corrige configuração antiga, mantendo o painel ligado ou parado
  reset       Recria o container preservando contas, dados e stacks do painel
  token       Mostra o token de primeiro acesso
  stop        Para somente o Portainer
  stop-all    Para TODOS os containers em execução
  status      Mostra estado e portas, sem iniciar serviços
  logs        Acompanha os logs
  help        Exibe esta ajuda
--lan expõe o painel na rede local. O token inicial permanece habilitado.
HELP
}
action=start lan=false
for arg in "$@"; do
    case "$arg" in --lan|--public) lan=true ;; -h|--help|help) help; exit 0 ;; *) action="$arg" ;; esac
done
case "$action" in start|on|up|repair|reset|recreate|token|stop|off|down|stop-all|stopall|down-all|kill-all|status|logs) ;; *) echo "Comando desconhecido: $action" >&2; exit 2 ;; esac
setup_environment
if ! setup_native docker || ! timeout 10 docker info >/dev/null 2>&1; then
    echo 'Docker indisponível nesta sessão. Verifique doctor; se necessário: sudo systemctl start docker.' >&2
    echo 'Se o grupo Docker acabou de ser configurado, abra uma nova sessão.' >&2
    exit 1
fi
exists() { docker container inspect "$container" >/dev/null 2>&1; }
token() {
    local value
    value=$(docker logs "$container" 2>&1 | sed $'s/\\x1b\\[[0-9;]*m//g' | grep -oE 'setup_token=[^[:space:]]+' | tail -n 1 | cut -d= -f2- || true)
    if [ -n "$value" ]; then printf 'Token de primeiro acesso: %s\n' "$value"; else echo 'Token não encontrado. Uma instância já configurada não precisa dele.'; fi
}
case "$action" in
    status) docker ps -a --filter "name=^/${container}$" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'; exit ;;
    token) token; exit ;;
    logs) docker logs -f "$container"; exit ;;
    stop|off|down) if exists; then docker stop "$container"; fi; echo 'Portainer parado. Dados preservados.'; exit ;;
    stop-all|stopall|down-all|kill-all)
        mapfile -t ids < <(docker ps -q)
        if ((${#ids[@]})); then docker stop "${ids[@]}"; fi
        echo 'Containers parados. O serviço Docker e o WSL podem continuar usando recursos.'; exit ;;
esac
# Evita duas recriações concorrentes, sem usar o lock de instalação.
mkdir -p "$SETUP_STATE_DIR"
exec {PORTAINER_LOCK_FD}>"$SETUP_STATE_DIR/$container.lock"
flock -n "$PORTAINER_LOCK_FD" || { echo 'Outra operação Portainer está em andamento.' >&2; exit 1; }
bind=127.0.0.1
if [ "$lan" = true ]; then bind=0.0.0.0; echo 'Modo LAN: painel acessível na rede. Conclua o primeiro acesso usando o token.'; fi
if [ "$action" = repair ] && ! exists; then
    echo 'Portainer sob demanda: será criado no primeiro uso.'
    exit 0
fi
was_running=false
image="$PORTAINER_IMAGE"
metadata="$SETUP_STATE_DIR/$container-before-reset.json"
if ! exists && [ -f "$metadata" ]; then
    image=$(python3 - "$metadata" <<'PYIMAGE'
import json, sys
value = json.load(open(sys.argv[1]))
print(value[0]['Image'])
PYIMAGE
    )
fi
recreate=false
if exists; then
    was_running=$(docker inspect "$container" --format '{{.State.Running}}')
    current_image=$(docker inspect "$container" --format '{{.Config.Image}}')
    [[ "$current_image" == portainer/portainer-ce* || "$current_image" == sha256:* ]] || { echo 'O nome portainer pertence a outra imagem. Nenhum container foi removido.' >&2; exit 1; }
    current_volume=$(docker inspect "$container" --format '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Name}}{{end}}{{end}}')
    [ "$current_volume" = "$volume" ] || { echo 'O painel usa armazenamento personalizado. Nenhum container ou dado foi removido; revise a configuração antes do reset.' >&2; exit 1; }
    # Reutiliza o ID da imagem existente para não fazer downgrade/upgrade da base de dados no reparo.
    image=$(docker inspect "$container" --format '{{.Image}}')
    existing_bind=$(docker inspect "$container" --format '{{(index (index .HostConfig.PortBindings "9000/tcp") 0).HostIp}}' 2>/dev/null || true)
    existing_https_bind=$(docker inspect "$container" --format '{{(index (index .HostConfig.PortBindings "9443/tcp") 0).HostIp}}' 2>/dev/null || true)
    existing_args=$(docker inspect "$container" --format '{{json .Config.Cmd}}')
    if [ "$existing_bind" != "$bind" ] || [ "$existing_https_bind" != "$bind" ] || [[ "$existing_args" == *--no-setup-token* ]] || [[ "$action" == reset || "$action" == recreate ]]; then recreate=true; fi
fi
if [ "$action" = repair ] && [ "$recreate" = false ]; then
    echo 'Portainer: configuração atual; estado de execução preservado.'
    exit 0
fi
if [ "$recreate" = true ]; then
    docker inspect "$container" > "$metadata"
    docker rm -f "$container"
fi
if ! exists; then
    if ! docker image inspect "$image" >/dev/null 2>&1; then timeout 300 docker pull "$image"; fi
    docker volume create "$volume" >/dev/null
    docker create --name "$container" --restart=no \
        --label io.meu-setup.managed=true \
        -p "$bind:$http_port:9000" -p "$bind:$https_port:9443" \
        -v /var/run/docker.sock:/var/run/docker.sock -v "$volume:/data" "$image" >/dev/null
fi
if [ "$action" = repair ] && [ "$was_running" != true ]; then
    echo 'Portainer reparado e mantido parado. Volume e imagem preservados.'
    exit 0
fi
docker start "$container" >/dev/null
# Aguarda resposta HTTP sem consumir/alterar a tela de primeiro acesso.
ready=false
for _ in {1..20}; do
    if curl -fsS --connect-timeout 1 --max-time 2 "http://127.0.0.1:$http_port/api/status" >/dev/null 2>&1; then ready=true; break; fi
    sleep 1
done
if [ "$ready" = false ]; then echo 'O painel ainda não respondeu. Consulte portainer logs; os dados foram preservados.' >&2; exit 1; fi
echo "Painel pronto: http://localhost:$http_port. Para parar: portainer stop."
token
if [ "$action" != repair ] && [ "${SETUP_NO_BROWSER:-false}" != true ] && command -v cmd.exe >/dev/null; then cmd.exe /c start '' "http://localhost:$http_port" >/dev/null 2>&1 || true; fi
