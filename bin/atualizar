#!/usr/bin/env bash
# ==============================================================================
# meu-setup: atualizar
# Script de manutenção e atualização contínua do ambiente de desenvolvimento.
# ==============================================================================

set -e

# Cores para o terminal
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m' # No Color

mostrar_banner() {
    echo -e "${CYAN}"
    echo "  ╔══════════════════════════════════════════════════╗"
    echo "  ║         🔄 Central de Atualização & Manutenção   ║"
    echo "  ║                   meu-setup                      ║"
    echo "  ╚══════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

log_etapa() {
    echo -e "\n${BLUE}${BOLD}[$1] $2${NC}"
}

log_sucesso() {
    echo -e "${GREEN}✔ $1${NC}"
}

log_info() {
    echo -e "${CYAN}ℹ $1${NC}"
}

log_aviso() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

# Resolve diretório real caso seja executado através de symlink
obter_diretorio_repo() {
    local source="${BASH_SOURCE[0]}"
    while [ -h "$source" ]; do
        local dir
        dir="$( cd -P "$( dirname "$source" )" >/dev/null 2>&1 && pwd )"
        source="$(readlink "$source")"
        [[ $source != /* ]] && source="$dir/$source"
    done
    local dir_bin
    dir_bin="$( cd -P "$( dirname "$source" )" >/dev/null 2>&1 && pwd )"
    echo "$( cd "$dir_bin/.." && pwd )"
}

mostrar_banner

# Solicita sudo uma única vez no início
echo -e "${YELLOW}Verificando permissões administrativas para atualizações do sistema...${NC}"
sudo -v
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
SUDO_PID=$!
trap 'kill $SUDO_PID 2>/dev/null || true' EXIT

# 1. Sistema Operacional (Ubuntu/Debian)
log_etapa "1/7" "Atualizando pacotes do sistema operacional Ubuntu (APT)..."
sudo apt update
sudo apt upgrade -y
log_sucesso "Pacotes do sistema operacional atualizados!"

# 2. Limpeza de pacotes órfãos e cache do APT
log_etapa "2/7" "Limpando pacotes desnecessários e cache de disco do APT..."
sudo apt autoremove -y
sudo apt clean
log_sucesso "Limpeza do APT concluída com sucesso!"

# 3. Ecossistema Python (uv)
log_etapa "3/7" "Verificando atualização do gerenciador Python (uv)..."
if command -v uv >/dev/null 2>&1; then
    uv self update 2>/dev/null || log_info "uv já está na versão mais recente."
    log_sucesso "uv verificado: $(uv --version)"
else
    log_aviso "uv não encontrado. Instale com o instalador do meu-setup."
fi

# 4. Ecossistema Node.js (fnm / pnpm)
log_etapa "4/7" "Verificando ferramentas do ecossistema Node.js & Web..."
if command -v pnpm >/dev/null 2>&1; then
    pnpm add -g pnpm 2>/dev/null || true
    log_sucesso "pnpm verificado: v$(pnpm --version 2>/dev/null || echo 'instalado')"
fi

if command -v fnm >/dev/null 2>&1; then
    log_sucesso "fnm verificado: $(fnm --version)"
fi

# 5. Ferramentas Visuais e Utilitários de Alta Performance (Rust & Go)
log_etapa "5/7" "Verificando ferramentas visuais e de performance (Lazydocker, Lazygit, Zoxide, Bat, Eza, Starship)..."
DIR_LOCAL_BIN="$HOME/.local/bin"
mkdir -p "$DIR_LOCAL_BIN"
ARCH="$(uname -m)"

# 5.1 Lazydocker
if command -v lazydocker >/dev/null 2>&1 || [ -f "$DIR_LOCAL_BIN/lazydocker" ]; then
    log_info "Verificando atualização do Lazydocker..."
    LAZY_ARCH=""
    case "$ARCH" in
        x86_64) LAZY_ARCH="x86_64" ;;
        aarch64|arm64) LAZY_ARCH="arm64" ;;
    esac

    if [ -n "$LAZY_ARCH" ]; then
        LATEST_TAG=$(curl -s "https://api.github.com/repos/jesseduffield/lazydocker/releases/latest" 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || true)
        if [ -n "$LATEST_TAG" ]; then
            TAR_FILE="lazydocker_${LATEST_TAG#v}_Linux_${LAZY_ARCH}.tar.gz"
            DOWNLOAD_URL="https://github.com/jesseduffield/lazydocker/releases/download/${LATEST_TAG}/${TAR_FILE}"
            TEMP_DIR=$(mktemp -d)
            if curl -fsSL "$DOWNLOAD_URL" -o "$TEMP_DIR/$TAR_FILE" 2>/dev/null; then
                tar -xzf "$TEMP_DIR/$TAR_FILE" -C "$TEMP_DIR" lazydocker 2>/dev/null || true
                if [ -f "$TEMP_DIR/lazydocker" ]; then
                    mv "$TEMP_DIR/lazydocker" "$DIR_LOCAL_BIN/lazydocker"
                    chmod +x "$DIR_LOCAL_BIN/lazydocker"
                    log_sucesso "Lazydocker verificado: $LATEST_TAG"
                fi
            fi
            rm -rf "$TEMP_DIR"
        fi
    fi
fi

# 5.2 Lazygit
if command -v lazygit >/dev/null 2>&1 || [ -f "$DIR_LOCAL_BIN/lazygit" ]; then
    log_info "Verificando atualização do Lazygit..."
    LG_ARCH=""
    case "$ARCH" in
        x86_64) LG_ARCH="x86_64" ;;
        aarch64|arm64) LG_ARCH="arm64" ;;
    esac

    if [ -n "$LG_ARCH" ]; then
        LATEST_TAG=$(curl -s "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || true)
        if [ -n "$LATEST_TAG" ]; then
            TAR_FILE="lazygit_${LATEST_TAG#v}_linux_${LG_ARCH}.tar.gz"
            DOWNLOAD_URL="https://github.com/jesseduffield/lazygit/releases/download/${LATEST_TAG}/${TAR_FILE}"
            TEMP_DIR=$(mktemp -d)
            if curl -fsSL "$DOWNLOAD_URL" -o "$TEMP_DIR/$TAR_FILE" 2>/dev/null; then
                tar -xzf "$TEMP_DIR/$TAR_FILE" -C "$TEMP_DIR" lazygit 2>/dev/null || true
                if [ -f "$TEMP_DIR/lazygit" ]; then
                    mv "$TEMP_DIR/lazygit" "$DIR_LOCAL_BIN/lazygit"
                    chmod +x "$DIR_LOCAL_BIN/lazygit"
                    log_sucesso "Lazygit verificado: $LATEST_TAG"
                fi
            fi
            rm -rf "$TEMP_DIR"
        fi
    fi
fi

# 5.3 Zoxide
if command -v zoxide >/dev/null 2>&1 || [ -f "$DIR_LOCAL_BIN/zoxide" ]; then
    log_info "Verificando atualização do Zoxide..."
    ZOX_ARCH=""
    case "$ARCH" in
        x86_64) ZOX_ARCH="x86_64" ;;
        aarch64|arm64) ZOX_ARCH="aarch64" ;;
    esac

    if [ -n "$ZOX_ARCH" ]; then
        LATEST_TAG=$(curl -s "https://api.github.com/repos/ajeetdsouza/zoxide/releases/latest" 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || true)
        if [ -n "$LATEST_TAG" ]; then
            TAR_FILE="zoxide-${LATEST_TAG#v}-${ZOX_ARCH}-unknown-linux-musl.tar.gz"
            DOWNLOAD_URL="https://github.com/ajeetdsouza/zoxide/releases/download/${LATEST_TAG}/${TAR_FILE}"
            TEMP_DIR=$(mktemp -d)
            if curl -fsSL "$DOWNLOAD_URL" -o "$TEMP_DIR/$TAR_FILE" 2>/dev/null; then
                tar -xzf "$TEMP_DIR/$TAR_FILE" -C "$TEMP_DIR" zoxide 2>/dev/null || true
                if [ -f "$TEMP_DIR/zoxide" ]; then
                    mv "$TEMP_DIR/zoxide" "$DIR_LOCAL_BIN/zoxide"
                    chmod +x "$DIR_LOCAL_BIN/zoxide"
                    log_sucesso "Zoxide verificado: $LATEST_TAG"
                fi
            fi
            rm -rf "$TEMP_DIR"
        fi
    fi
fi

# 5.4 Bat
if command -v bat >/dev/null 2>&1 || [ -f "$DIR_LOCAL_BIN/bat" ]; then
    log_info "Verificando atualização do Bat..."
    BAT_ARCH=""
    case "$ARCH" in
        x86_64) BAT_ARCH="x86_64" ;;
        aarch64|arm64) BAT_ARCH="aarch64" ;;
    esac

    if [ -n "$BAT_ARCH" ]; then
        LATEST_TAG=$(curl -s "https://api.github.com/repos/sharkdp/bat/releases/latest" 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || true)
        if [ -n "$LATEST_TAG" ]; then
            TAR_FILE="bat-${LATEST_TAG}-${BAT_ARCH}-unknown-linux-musl.tar.gz"
            DOWNLOAD_URL="https://github.com/sharkdp/bat/releases/download/${LATEST_TAG}/${TAR_FILE}"
            TEMP_DIR=$(mktemp -d)
            if curl -fsSL "$DOWNLOAD_URL" -o "$TEMP_DIR/$TAR_FILE" 2>/dev/null; then
                tar -xzf "$TEMP_DIR/$TAR_FILE" -C "$TEMP_DIR" 2>/dev/null || true
                BIN_FOUND=$(find "$TEMP_DIR" -type f -name "bat" | head -n 1)
                if [ -n "$BIN_FOUND" ] && [ -f "$BIN_FOUND" ]; then
                    mv "$BIN_FOUND" "$DIR_LOCAL_BIN/bat"
                    chmod +x "$DIR_LOCAL_BIN/bat"
                    log_sucesso "Bat verificado: $LATEST_TAG"
                fi
            fi
            rm -rf "$TEMP_DIR"
        fi
    fi
fi

# 5.5 Eza
if command -v eza >/dev/null 2>&1 || [ -f "$DIR_LOCAL_BIN/eza" ]; then
    log_info "Verificando atualização do Eza..."
    EZA_ARCH=""
    case "$ARCH" in
        x86_64) EZA_ARCH="x86_64-unknown-linux-gnu" ;;
        aarch64|arm64) EZA_ARCH="aarch64-unknown-linux-gnu" ;;
    esac

    if [ -n "$EZA_ARCH" ]; then
        LATEST_TAG=$(curl -s "https://api.github.com/repos/eza-community/eza/releases/latest" 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || true)
        if [ -n "$LATEST_TAG" ]; then
            TAR_FILE="eza_${EZA_ARCH}.tar.gz"
            DOWNLOAD_URL="https://github.com/eza-community/eza/releases/download/${LATEST_TAG}/${TAR_FILE}"
            TEMP_DIR=$(mktemp -d)
            if curl -fsSL "$DOWNLOAD_URL" -o "$TEMP_DIR/$TAR_FILE" 2>/dev/null; then
                tar -xzf "$TEMP_DIR/$TAR_FILE" -C "$TEMP_DIR" 2>/dev/null || true
                BIN_FOUND=$(find "$TEMP_DIR" -type f -name "eza" | head -n 1)
                if [ -n "$BIN_FOUND" ] && [ -f "$BIN_FOUND" ]; then
                    mv "$BIN_FOUND" "$DIR_LOCAL_BIN/eza"
                    chmod +x "$DIR_LOCAL_BIN/eza"
                    log_sucesso "Eza verificado: $LATEST_TAG"
                fi
            fi
            rm -rf "$TEMP_DIR"
        fi
    fi
fi

# 5.6 Starship
if command -v starship >/dev/null 2>&1; then
    log_sucesso "Starship verificado: $(starship --version | head -n 1)"
fi

# 6. Sincronização do repositório meu-setup
log_etapa "6/7" "Sincronizando repositório meu-setup com o GitHub..."
DIR_SETUP="$(obter_diretorio_repo)"
if [ -d "$DIR_SETUP/.git" ]; then
    log_info "Repositório detectado em: $DIR_SETUP"
    CURRENT_BRANCH=$(git -C "$DIR_SETUP" branch --show-current 2>/dev/null || echo "main")
    if git -C "$DIR_SETUP" pull origin "$CURRENT_BRANCH" 2>/dev/null; then
        log_sucesso "Repositório meu-setup sincronizado com o GitHub na branch $CURRENT_BRANCH!"
    else
        log_aviso "Não foi possível puxar commits do GitHub (sem conexão ou alterações locais pendentes)."
    fi

    # Garante que os symlinks em ~/.local/bin estejam atualizados
    mkdir -p "$DIR_LOCAL_BIN"
    [ -f "$DIR_SETUP/bin/novo-projeto" ] && ln -sf "$DIR_SETUP/bin/novo-projeto" "$DIR_LOCAL_BIN/novo-projeto"
    [ -f "$DIR_SETUP/bin/atualizar" ] && ln -sf "$DIR_SETUP/bin/atualizar" "$DIR_LOCAL_BIN/atualizar"
    [ -f "$DIR_SETUP/bin/diagnostico" ] && ln -sf "$DIR_SETUP/bin/diagnostico" "$DIR_LOCAL_BIN/diagnostico"
    [ -f "$DIR_SETUP/bin/portainer" ] && ln -sf "$DIR_SETUP/bin/portainer" "$DIR_LOCAL_BIN/portainer"
    log_sucesso "Atalhos executáveis em $DIR_LOCAL_BIN/ sincronizados!"
else
    log_info "Diretório $DIR_SETUP não é um repositório git. Etapa ignorada."
fi

# 7. Manutenção do Docker e Portainer
log_etapa "7/7" "Verificando status e manutenção do Docker e Portainer..."
if command -v docker >/dev/null 2>&1; then
    if docker info >/dev/null 2>&1; then
        echo -e "${CYAN}Docker Engine está ativo e respondendo.${NC}"

        # Atualiza a imagem do Portainer se ela já estiver presente
        if docker images --format '{{.Repository}}' 2>/dev/null | grep -Eq "portainer/portainer-ce"; then
            log_info "Verificando atualização da imagem do Portainer CE..."
            docker pull portainer/portainer-ce:latest >/dev/null 2>&1 || true
            log_sucesso "Imagem do Portainer CE verificada e atualizada!"
        fi

        read -rp "Deseja realizar uma faxina segura no Docker (remover containers parados, redes órfãs e imagens sem uso)? [s/N]: " resp_docker
        if [[ "$resp_docker" =~ ^[sS]$ ]]; then
            log_info "Executando docker system prune..."
            docker system prune -f
            log_sucesso "Faxina do Docker concluída!"
        else
            log_info "Limpeza do Docker ignorada pelo usuário."
        fi
    elif sudo docker info >/dev/null 2>&1 || (command -v systemctl >/dev/null 2>&1 && sudo systemctl is-active --quiet docker); then
        log_aviso "Docker Engine está ativo no systemd, mas sua sessão atual ainda não carregou as permissões. Feche e reabra o terminal para usar sem sudo."
    else
        log_aviso "Docker está instalado, mas o serviço não está ativo no momento (systemd). Inicie com: sudo systemctl start docker"
    fi
else
    log_info "Docker não instalado nesta máquina."
fi

# Resumo Final e Espaço em Disco
echo -e "\n${GREEN}══════════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}${BOLD}✔ Atualização completa concluída com sucesso!${NC}"
echo -e "${GREEN}══════════════════════════════════════════════════════════${NC}"

# Informação de espaço em disco no WSL
ESPACO_DISCO=$(df -h / | awk 'NR==2 {print $4 " livres (usado: " $5 " de " $2 ")"}')
echo -e "${CYAN}💾 Espaço em disco do WSL:${NC} $ESPACO_DISCO"
echo -e "${CYAN}🚀 Seu ambiente está pronto e com as versões mais recentes!${NC}\n"
