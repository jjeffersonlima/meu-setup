#!/usr/bin/env bash
# ==============================================================================
# meu-setup: atualizar
# Script de manutenção e atualização contínua do ambiente de desenvolvimento.
# Suporta flags de linha de comando para automação (--yes, --no-prune, --help).
# ==============================================================================

set -e

# Cores para o terminal
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m' # No Color

mostrar_banner() {
    if [ -t 1 ]; then
        echo -e "${CYAN}"
        echo "  ╔══════════════════════════════════════════════════╗"
        echo "  ║         🔄 Central de Atualização & Manutenção   ║"
        echo "  ║                   meu-setup                      ║"
        echo "  ╚══════════════════════════════════════════════════╝"
        echo -e "${NC}"
    fi
}

mostrar_ajuda() {
    echo "Uso: atualizar [OPÇÕES]"
    echo ""
    echo "Opções:"
    echo "  -y, --yes          Executa todas as atualizações de forma não-interativa (com faxina Docker)"
    echo "  --no-prune         Pula a faxina do Docker durante a execução"
    echo "  -h, --help         Exibe esta mensagem de ajuda"
}

log_etapa() {
    echo -e "\n${BLUE}${BOLD}[$1] $2${NC}"
}

log_sucesso() {
    echo -e "${GREEN}✔ $1${NC}"
}

log_info() {
    echo -e "${CYAN}ℹ $1${NC}"
}

log_aviso() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

# Resolve diretório real caso seja executado através de symlink
obter_diretorio_repo() {
    local source="${BASH_SOURCE[0]}"
    while [ -h "$source" ]; do
        local dir
        dir="$( cd -P "$( dirname "$source" )" >/dev/null 2>&1 && pwd )"
        source="$(readlink "$source")"
        [[ $source != /* ]] && source="$dir/$source"
    done
    local dir_bin
    dir_bin="$( cd -P "$( dirname "$source" )" >/dev/null 2>&1 && pwd )"
    cd "$dir_bin/.." && pwd
}

# Processamento de flags
AUTO_YES=false
SKIP_PRUNE=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -y|--yes)
            AUTO_YES=true
            shift
            ;;
        --no-prune)
            SKIP_PRUNE=true
            shift
            ;;
        -h|--help)
            mostrar_ajuda
            exit 0
            ;;
        *)
            echo -e "${RED}Opção desconhecida: $1${NC}"
            mostrar_ajuda
            exit 1
            ;;
    esac
done

mostrar_banner

# Solicita sudo uma única vez no início
echo -e "${YELLOW}Verificando permissões administrativas para atualizações do sistema...${NC}"
if [ "$EUID" -ne 0 ]; then
    sudo -v
    while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
    SUDO_PID=$!
    trap 'kill $SUDO_PID 2>/dev/null || true' EXIT
fi

# 1. Sistema Operacional (Ubuntu/Debian)
log_etapa "1/7" "Atualizando pacotes do sistema operacional Ubuntu (APT)..."
sudo env DEBIAN_FRONTEND=noninteractive apt-get update -y
sudo env DEBIAN_FRONTEND=noninteractive apt-get upgrade -y
log_sucesso "Pacotes do sistema operacional atualizados!"

# 2. Limpeza de pacotes órfãos e cache do APT
log_etapa "2/7" "Limpando pacotes desnecessários e cache de disco do APT..."
sudo env DEBIAN_FRONTEND=noninteractive apt-get autoremove -y
sudo env DEBIAN_FRONTEND=noninteractive apt-get clean
log_sucesso "Limpeza do APT concluída com sucesso!"

# 3. Ecossistema Python (uv)
log_etapa "3/7" "Verificando atualização do gerenciador Python (uv)..."
if command -v uv >/dev/null 2>&1; then
    uv self update 2>/dev/null || log_info "uv já está na versão mais recente."
    log_sucesso "uv verificado: $(uv --version)"
else
    log_aviso "uv não encontrado. Instale com o instalador do meu-setup."
fi

# 4. Ecossistema Node.js (fnm / pnpm)
log_etapa "4/7" "Verificando ferramentas do ecossistema Node.js & Web..."
if command -v pnpm >/dev/null 2>&1; then
    pnpm add -g pnpm 2>/dev/null || true
    log_sucesso "pnpm verificado: v$(pnpm --version 2>/dev/null || echo 'instalado')"
fi

if command -v fnm >/dev/null 2>&1; then
    log_sucesso "fnm verificado: $(fnm --version)"
fi

# 5. Ferramentas Visuais e Utilitários de Alta Performance (Rust & Go)
log_etapa "5/7" "Verificando ferramentas visuais e de performance (Lazydocker, Lazygit, Zoxide, Bat, Eza, Starship)..."
DIR_LOCAL_BIN="$HOME/.local/bin"
mkdir -p "$DIR_LOCAL_BIN"

# Starship
if command -v starship >/dev/null 2>&1; then
    log_info "Atualizando Starship..."
    curl -sS https://starship.rs/install.sh | sh -s -- -y -b "$DIR_LOCAL_BIN" >/dev/null 2>&1 || true
    log_sucesso "Starship atualizado!"
fi

# Lazydocker
if command -v lazydocker >/dev/null 2>&1 || [ -f "$DIR_LOCAL_BIN/lazydocker" ]; then
    log_info "Verificando Lazydocker..."
    arch="$(uname -m)"
    lazy_arch=""
    case "$arch" in
        x86_64) lazy_arch="x86_64" ;;
        aarch64|arm64) lazy_arch="arm64" ;;
    esac
    if [ -n "$lazy_arch" ]; then
        latest_tag=$(curl -s "https://api.github.com/repos/jesseduffield/lazydocker/releases/latest" 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || true)
        if [ -n "$latest_tag" ]; then
            tar_file="lazydocker_${latest_tag#v}_Linux_${lazy_arch}.tar.gz"
            download_url="https://github.com/jesseduffield/lazydocker/releases/download/${latest_tag}/${tar_file}"
            temp_dir=$(mktemp -d)
            if curl -fsSL "$download_url" -o "$temp_dir/$tar_file" 2>/dev/null; then
                tar -xzf "$temp_dir/$tar_file" -C "$temp_dir" lazydocker 2>/dev/null || true
                [ -f "$temp_dir/lazydocker" ] && mv "$temp_dir/lazydocker" "$DIR_LOCAL_BIN/lazydocker" && chmod +x "$DIR_LOCAL_BIN/lazydocker"
            fi
            rm -rf "$temp_dir"
            log_sucesso "Lazydocker atualizado para $latest_tag!"
        fi
    fi
fi

# Lazygit
if command -v lazygit >/dev/null 2>&1 || [ -f "$DIR_LOCAL_BIN/lazygit" ]; then
    log_info "Verificando Lazygit..."
    arch="$(uname -m)"
    lg_arch=""
    case "$arch" in
        x86_64) lg_arch="x86_64" ;;
        aarch64|arm64) lg_arch="arm64" ;;
    esac
    if [ -n "$lg_arch" ]; then
        latest_tag=$(curl -s "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || true)
        if [ -n "$latest_tag" ]; then
            tar_file="lazygit_${latest_tag#v}_linux_${lg_arch}.tar.gz"
            download_url="https://github.com/jesseduffield/lazygit/releases/download/${latest_tag}/${tar_file}"
            temp_dir=$(mktemp -d)
            if curl -fsSL "$download_url" -o "$temp_dir/$tar_file" 2>/dev/null; then
                tar -xzf "$temp_dir/$tar_file" -C "$temp_dir" lazygit 2>/dev/null || true
                [ -f "$temp_dir/lazygit" ] && mv "$temp_dir/lazygit" "$DIR_LOCAL_BIN/lazygit" && chmod +x "$DIR_LOCAL_BIN/lazygit"
            fi
            rm -rf "$temp_dir"
            log_sucesso "Lazygit atualizado para $latest_tag!"
        fi
    fi
fi

# Zoxide
if command -v zoxide >/dev/null 2>&1 || [ -f "$DIR_LOCAL_BIN/zoxide" ]; then
    log_info "Verificando Zoxide..."
    curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | BIN_DIR="$DIR_LOCAL_BIN" sh >/dev/null 2>&1 || true
    log_sucesso "Zoxide atualizado!"
fi

# 6. Sincronização e Atualização do Repositório meu-setup
log_etapa "6/7" "Verificando atualizações no repositório meu-setup..."
DIR_SETUP="$(obter_diretorio_repo)"

if [ -d "$DIR_SETUP/.git" ]; then
    log_info "Diretório do projeto detectado em: $DIR_SETUP"
    cd "$DIR_SETUP"
    
    # Verifica se há alterações locais não commitadas
    if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
        log_aviso "Você possui modificações locais em $DIR_SETUP."
        log_aviso "Para não perder suas alterações, 'git pull' foi pulado com segurança."
    else
        log_info "Buscando atualizações no GitHub..."
        git fetch origin >/dev/null 2>&1 || true
        UPSTREAM='@{u}'
        LOCAL=$(git rev-parse @ 2>/dev/null || true)
        REMOTE=$(git rev-parse "$UPSTREAM" 2>/dev/null || true)

        if [ "$LOCAL" = "$REMOTE" ]; then
            log_sucesso "meu-setup já está na versão mais recente!"
        else
            log_info "Atualizando arquivos locais com a versão mais recente..."
            git pull --ff-only origin main 2>/dev/null || git pull 2>/dev/null || true
            log_sucesso "meu-setup atualizado com sucesso!"
        fi
    fi

    # Reconecta symlinks se necessário
    mkdir -p "$DIR_LOCAL_BIN"
    for util in "novo-projeto" "atualizar" "diagnostico" "portainer"; do
        if [ -f "$DIR_SETUP/bin/$util" ]; then
            ln -sf "$DIR_SETUP/bin/$util" "$DIR_LOCAL_BIN/$util"
            chmod +x "$DIR_SETUP/bin/$util"
        fi
    done
else
    log_info "Diretório $DIR_SETUP não é um repositório git. Etapa ignorada."
fi

# 7. Manutenção do Docker e Portainer
log_etapa "7/7" "Verificando status e manutenção do Docker e Portainer..."
if command -v docker >/dev/null 2>&1; then
    if docker info >/dev/null 2>&1; then
        echo -e "${CYAN}Docker Engine está ativo e respondendo.${NC}"

        # Atualiza a imagem do Portainer se ela já estiver presente
        if docker images --format '{{.Repository}}' 2>/dev/null | grep -Eq "portainer/portainer-ce"; then
            log_info "Verificando atualização da imagem do Portainer CE..."
            docker pull portainer/portainer-ce:latest >/dev/null 2>&1 || true
            log_sucesso "Imagem do Portainer CE verificada e atualizada!"
        fi

        fazer_prune=false
        if [ "$AUTO_YES" = true ] && [ "$SKIP_PRUNE" = false ]; then
            fazer_prune=true
        elif [ "$SKIP_PRUNE" = false ] && [ -t 0 ]; then
            read -rp "Deseja realizar uma faxina segura no Docker (remover containers parados, redes órfãs e imagens sem uso)? [s/N]: " resp_docker
            if [[ "$resp_docker" =~ ^[sS]$ ]]; then
                fazer_prune=true
            fi
        fi

        if [ "$fazer_prune" = true ]; then
            log_info "Executando docker system prune..."
            docker system prune -f
            log_sucesso "Faxina do Docker concluída!"
        else
            log_info "Limpeza do Docker pulada."
        fi
    elif sudo docker info >/dev/null 2>&1 || (command -v systemctl >/dev/null 2>&1 && sudo systemctl is-active --quiet docker); then
        log_aviso "Docker Engine está ativo no systemd, mas sua sessão atual ainda não carregou as permissões. Feche e reabra o terminal para usar sem sudo."
    else
        log_aviso "Docker está instalado, mas o serviço não está ativo no momento (systemd). Inicie com: sudo systemctl start docker"
    fi
else
    log_info "Docker não instalado nesta máquina."
fi

# Resumo Final e Espaço em Disco
echo -e "\n${GREEN}══════════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}${BOLD}✔ Atualização completa concluída com sucesso!${NC}"
echo -e "${GREEN}══════════════════════════════════════════════════════════${NC}"

# Informação de espaço em disco no WSL
ESPACO_DISCO=$(df -h / | awk 'NR==2 {print $4 " livres (usado: " $5 " de " $2 ")"}')
echo -e "${CYAN}💾 Espaço em disco do WSL:${NC} $ESPACO_DISCO"
echo -e "${CYAN}🚀 Seu ambiente está pronto e com as versões mais recentes!${NC}\n"
