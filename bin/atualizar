#!/usr/bin/env bash
# meu-setup: guia de manutenção, sem executar atualizações ou reparos.
set -euo pipefail
DIR_SETUP="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
while (($#)); do
    case "$1" in
        -h|--help)
            echo 'Uso: atualizar'
            echo 'Mostra os comandos de atualização das ferramentas selecionadas.'
            echo 'Não acessa a rede, não instala, não repara e não remove arquivos.'
            exit 0 ;;
        -y|--yes|--system|--no-repo|--config-only|--user-only|--no-ai|--no-prune|--clean-docker)
            echo "Opção antiga $1: o comando agora é somente informativo." ;;
        *) echo "Opção desconhecida: $1" >&2; exit 2 ;;
    esac
    shift
done
exec python3 -B "$DIR_SETUP/lib/update_guide.py"
