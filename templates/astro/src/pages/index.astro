---
const titulo = "Meu primeiro site";
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
  </head>
  <body>
    <main>
      <h1>{titulo}</h1>
      <p>Edite src/pages/index.astro e veja suas mudanças no navegador.</p>
    </main>
  </body>
</html>
<style>
  body { font-family: system-ui, sans-serif; margin: 0; background: #f5f7fb; color: #162033; }
  main { max-width: 48rem; margin: 15vh auto; padding: 2rem; }
  h1 { font-size: clamp(2rem, 6vw, 4rem); }
</style>
